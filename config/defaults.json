{
  "app": {
    "name": "Alice AI Ultra Pet",
    "version": "2.0.0",
    "language": "tr",
    "start_on_boot": false,
    "debug": false
  },
  "window": {
    "width": 320,
    "height": 320,
    "x": 1200,
    "y": 600,
    "always_on_top": true,
    "opacity": 1.0,
    "scale": 1.0
  },
  "appearance": {
    "theme": "dark_cyber",
    "glow_intensity": 0.8,
    "panel_transparency": 0.95,
    "accent_color": "violet"
  },
  "animation": {
    "fps": 12,
    "frame_delay_ms": 83,
    "idle_speed": 1.0,
    "talk_speed": 1.2,
    "emotion_transition": true,
    "low_performance_mode": false
  },
  "ai": {
    "active_provider": "ollama",
    "providers": {
      "ollama": {
        "type": "ollama",
        "base_url": "http://127.0.0.1:11434",
        "model": "qwen2.5:3b",
        "temperature": 0.7,
        "max_tokens": 512
      }
    },
    "system_prompt": "",
    "timeout": 120,
    "stream": false,
    "history_length": 20
  },
  "voice": {
    "enabled": true,
    "engine": "voicevox",
    "auto_speak": true,
    "volume": 1.0,
    "voicevox": {
      "base_url": "http://127.0.0.1:50021",
      "speaker_id": 47,
      "speed_scale": 1.0,
      "pitch_scale": 0.0,
      "intonation_scale": 1.0,
      "volume_scale": 1.0,
      "pre_phoneme_length": 0.1,
      "post_phoneme_length": 0.1
    },
    "piper": {
      "executable": "piper",
      "model": "",
      "speaker": 0,
      "speed": 1.0,
      "enabled": false
    }
  },
  "stt": {
    "enabled": false,
    "engine": "faster_whisper",
    "model": "base",
    "language": "tr",
    "device": "default",
    "push_to_talk_key": "ctrl"
  },
  "memory": {
    "enabled": true,
    "max_history": 100,
    "auto_pin_threshold": 5
  },
  "character": {
    "active": "alice",
    "random_daily_outfit": true,
    "favorite_outfit": ""
  },
  "desktop_awareness": {
    "enabled": true,
    "idle_timeout_minutes": 5,
    "cpu_warning_threshold": 80,
    "check_interval_seconds": 30
  }
}
